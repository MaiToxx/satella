{
  "name": "satella-rgb",
  "version": "1.2.0",
  "description": "Satella — Contrôle des LEDs et macros pour clavier SURMEN GS98 et souris Risophy PC365A",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.satella.rgb",
    "productName": "Satella",
    "npmRebuild": false,
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Satella-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MaiToxx",
        "repo": "satella",
        "releaseType": "release"
      }
    ]
  },
  "author": "xavier45letop@gmail.com",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^2.9.0",
    "node-hid": "^3.1.0",
    "uiohook-napi": "^1.5.4"
  }
}
